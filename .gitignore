# Data (downloaded via scripts/download_data.py)
data/raw/
data/processed/
*.npy
*.npz
*.parquet

# Generated reports (regenerate with `python -m pdm.cli audit`); a curated
# snapshot is committed separately under docs/ for the deliverable.
docs/reports/

# Experiment tracking / artifacts
mlruns/
mlartifacts/
optuna.db
*.sqlite
*.db
!models/artifacts/**

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/
.coverage
htmlcov/

# Editors / OS
.vscode/
.idea/
.claude/
.DS_Store
Thumbs.db

# Deliverables assembled outside the repo
deliverables/

# Local scripts that assemble the selection-process deliverables (docx,
# slide decks, architecture PDF), not part of the pipeline or API.
scripts/fill_docx_template.py
scripts/build_slides.py
scripts/build_architecture_pdf.py
scripts/generate_deliverable_assets.py

# Offline pip wheelhouse for Docker builds on flaky networks (see
# docker/Dockerfile.api); regenerate locally, never commit the wheels.
docker/wheelhouse/*
!docker/wheelhouse/.gitkeep
