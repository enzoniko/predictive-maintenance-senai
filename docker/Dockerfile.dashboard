# See Dockerfile.api for why this targets Linux x86-64.
FROM python:3.11-slim

WORKDIR /app

COPY requirements.txt pyproject.toml ./
RUN pip install --no-cache-dir -r requirements.txt

COPY src/ src/
COPY configs/ configs/
RUN pip install --no-cache-dir -e .

EXPOSE 8501
ENV PDM_API_URL=http://api:8000
CMD ["streamlit", "run", "src/pdm/serving/dashboard.py", "--server.address=0.0.0.0"]
